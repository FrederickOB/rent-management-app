# Local development settings. Copy to .env (never commit .env). Deployed environments take
# these from the secrets manager (CLAUDE.md section 10). Every value below is dev-only.

# PostgreSQL (Docker Compose maps it to 54320 to avoid a local 5432)
DATABASE_URL=postgres://rent_app:rent_app_dev@localhost:54320/rent
DATABASE_OWNER_URL=postgres://rent_owner:rent_owner_dev@localhost:54320/rent
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54320/postgres

# Object storage (SeaweedFS S3 gateway, ADR-013)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rentdev
S3_SECRET_ACCESS_KEY=rentdevsecret
S3_BUCKET_FILES=rent-files
S3_BUCKET_EVIDENCE=rent-evidence

# Email (Mailpit: UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Rent Platform <no-reply@rent.local>
OPS_ALERT_EMAIL=ops@rent.local

# Fake providers (dev inbox at http://localhost:4010)
FAKE_PROVIDERS_URL=http://localhost:4010
# Settings of the fake provider server itself (empty means its dev-only default). The API
# will use the same secrets to verify the fake webhooks once payments (M4b) and WhatsApp (M6) land.
FAKE_PAYMENTS_SECRET_KEY=
FAKE_PAYMENTS_WEBHOOK_URL=
FAKE_WHATSAPP_APP_SECRET=
FAKE_WHATSAPP_WEBHOOK_URL=
FAKE_IDENTITY_WEBHOOK_URL=
MAILPIT_URL=http://localhost:8025

# Apps
APP_NAME=Rent Platform
API_BASE_URL=http://localhost:3700
WEB_ORIGIN=http://localhost:3701
LINKS_ORIGIN=http://localhost:3702
TENANT_WEB_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3700

# Auth (Better Auth). At least 32 characters.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-0000000000000000

# Field encryption: local stand-in for KMS, and the blind-index master secret.
# Each is 32 random bytes, base64. Generate with: openssl rand -base64 32
LOCAL_KMS_MASTER_KEY=ZGV2LW9ubHkta21zLW1hc3Rlci1rZXktMzJieXRlcyE=
BLIND_INDEX_MASTER_KEY=ZGV2LW9ubHktYmxpbmQtaW5kZXgta2V5LTMyYnl0ZSE=
