# Local development settings. Copy to .env (never commit .env). Deployed environments take
# these from the secrets manager (CLAUDE.md section 10). Every value below is dev-only.

# PostgreSQL (Docker Compose maps it to 54320 to avoid a local 5432)
DATABASE_URL=postgres://rent_app:rent_app_dev@localhost:54320/rent
DATABASE_OWNER_URL=postgres://rent_owner:rent_owner_dev@localhost:54320/rent
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:54320/postgres

# Object storage (SeaweedFS S3 gateway, ADR-013)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rentdev
S3_SECRET_ACCESS_KEY=rentdevsecret
S3_BUCKET_FILES=rent-files
S3_BUCKET_EVIDENCE=rent-evidence

# Email (Mailpit: UI at http://localhost:8025)
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Rent Platform <no-reply@rent.local>
OPS_ALERT_EMAIL=ops@rent.local

# Fake providers (dev inbox at http://localhost:4010)
FAKE_PROVIDERS_URL=http://localhost:4010
# Settings of the fake provider server itself (empty means its dev-only default). The API uses
# the same payments key to call the fake and verify its webhooks (M4b); WhatsApp's arrives in M6.
# Without PAYSTACK_SECRET_KEY, the API charges through the fake under Paystack's name.
FAKE_PAYMENTS_SECRET_KEY=
# Where the fake sends payment webhooks. From the Docker container to an API on the host:
# http://host.docker.internal:3700/webhooks/paystack. Empty: no webhooks, and payments arrive
# through verify-pending (every 5 minutes) and the daily reconciliation instead.
FAKE_PAYMENTS_WEBHOOK_URL=
FAKE_WHATSAPP_APP_SECRET=
FAKE_IDENTITY_WEBHOOK_URL=
# M6 messaging: where the fake sends inbound messages and delivery reports. Unset, Docker Compose
# points them at the API on the host (docker-compose.yml); set one empty to turn it off. Hubtel
# and Postmark carry our secret on the URL (the API's dev stand-in locally).
# FAKE_WHATSAPP_WEBHOOK_URL=http://host.docker.internal:3700/webhooks/whatsapp
# FAKE_WHATSAPP_PHONE_NUMBER_ID=100000000000001
# FAKE_SMS_INBOUND_URL=http://host.docker.internal:3700/webhooks/sms/inbound?secret=dev-only-messaging-webhook-secret
# FAKE_SMS_STATUS_URL=http://host.docker.internal:3700/webhooks/sms/status?secret=dev-only-messaging-webhook-secret
# FAKE_EMAIL_INBOUND_URL=http://host.docker.internal:3700/webhooks/email/inbound?secret=dev-only-messaging-webhook-secret
# FAKE_EMAIL_EVENTS_URL=http://host.docker.internal:3700/webhooks/email/events?secret=dev-only-messaging-webhook-secret
MAILPIT_URL=http://localhost:8025

# Apps
APP_NAME=Rent Platform
API_BASE_URL=http://localhost:3700
WEB_ORIGIN=http://localhost:3701
LINKS_ORIGIN=http://localhost:3702
TENANT_WEB_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3700

# Auth (Better Auth). At least 32 characters.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-0000000000000000

# M10: the API's test controls for the web e2e specs (POST /_test/subscriptions/{companyId}/invoice
# forces an overdue subscription invoice), for platform admins only. on or off (the default when
# unset). Leave it off for everyday development: CI's e2e job turns it on for the apps it starts.
# The API refuses to start with it on in production.
E2E_TEST_CONTROLS=off
# The e2e database's owner URL, for the cooling-off test control only (never in production).
E2E_DATABASE_OWNER_URL=

# The key apps/links sends to the API's links endpoints (M3). Leave it unset locally: both sides
# then use a shared development key. Production must set its own (at least 32 characters).
# LINKS_API_KEY=

# Field encryption: local stand-in for KMS, and the blind-index master secret.
# Each is 32 random bytes, base64. Generate with: openssl rand -base64 32
LOCAL_KMS_MASTER_KEY=ZGV2LW9ubHkta21zLW1hc3Rlci1rZXktMzJieXRlcyE=
BLIND_INDEX_MASTER_KEY=ZGV2LW9ubHktYmxpbmQtaW5kZXgta2V5LTMyYnl0ZSE=

# Payments (M4b). Live rent collection stays off until counsel's written opinion on Bank of Ghana
# licensing is in hand (OQ-03): the API refuses a live Paystack key unless this says `enabled`.
# LIVE_RENT_COLLECTION=disabled
# Who enabled it (a name or ticket, from the deployment's configuration); the startup log names it.
# LIVE_RENT_COLLECTION_ENABLED_BY=
# Paystack test keys come from the secrets manager; never commit one. The optional sandbox smoke
# test runs only when PAYSTACK_TEST_SECRET_KEY is set.
# PAYSTACK_SECRET_KEY=
# PAYSTACK_TEST_SECRET_KEY=
# The domain for the per-tenant customer email Paystack requires (OQ-06), on a platform-owned
# domain, never derived from a phone number. The founder supplies it.
# PAYMENTS_CUSTOMER_EMAIL_DOMAIN=

# Messaging (M6). Without these the API sends WhatsApp, SMS and push through the fake providers
# and email through Mailpit; secrets come from the secrets manager, never this file.
# Meta WhatsApp Cloud API (decision 3): system-user token, app secret (webhook signatures), the
# verify token Meta's subscription check sends, the Graph version and the shared number's id.
# META_ACCESS_TOKEN=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_GRAPH_VERSION=v23.0
# META_SHARED_PHONE_NUMBER_ID=
# Hubtel SMS (decision 1): API ID, API Key, the approved sender ID, and our secrets on its
# delivery and inbound callback URLs (?secret=).
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_SENDER_ID=
# SMS_STATUS_WEBHOOK_SECRET=
# SMS_INBOUND_WEBHOOK_SECRET=
# Postmark (decision 2): server token, our secrets on the inbound and events webhooks (Basic
# password or ?secret=), and the reply-address domain (reply+<token>@EMAIL_INBOUND_DOMAIN).
# POSTMARK_SERVER_TOKEN=
# EMAIL_INBOUND_WEBHOOK_SECRET=
# EMAIL_EVENTS_WEBHOOK_SECRET=
# EMAIL_INBOUND_DOMAIN=
# Expo push (decision 5), when the project requires an access token.
# EXPO_ACCESS_TOKEN=
# Optional sandbox smoke tests (packages/integrations), skipped unless these are set.
# META_TEST_ACCESS_TOKEN=
# META_TEST_PHONE_NUMBER_ID=
# META_TEST_WABA_ID=
# META_TEST_RECIPIENT=
# HUBTEL_TEST_CLIENT_ID=
# HUBTEL_TEST_CLIENT_SECRET=
# HUBTEL_TEST_BASE_URL=
# HUBTEL_TEST_RECIPIENT=
# POSTMARK_TEST_SERVER_TOKEN=
# POSTMARK_TEST_FROM=
# POSTMARK_TEST_RECIPIENT=
# EXPO_TEST_PUSH_TOKEN=

# Malware scanning of uploads (M11 decision 6). `fake` (the default) knows only the EICAR test
# file; `clamav` scans with clamd: start it with `docker compose --profile scan up -d clamav`
# (about 1.5 GB of memory; it loads its signatures for a few minutes first). Production refuses
# `fake`.
MALWARE_SCANNER=fake
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310
