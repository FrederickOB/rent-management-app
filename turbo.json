{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.json", ".env.example"],
  "globalEnv": ["NODE_ENV", "CI"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_ADMIN_URL",
    "S3_ENDPOINT",
    "SMTP_URL",
    "FAKE_PROVIDERS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "web-build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "cache": false
    },
    "test:unit": {
      "outputs": []
    },
    "test:e2e": {
      "cache": false
    }
  }
}
