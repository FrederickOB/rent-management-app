{
  "expo": {
    "name": "Rent Platform",
    "slug": "rent-platform-tenant",
    "scheme": "rentplatform",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rentplatform.tenant",
      "supportsTablet": false
    },
    "android": {
      "package": "com.rentplatform.tenant"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
